@model BizTrack.Models.Budget

@{
    ViewData["Title"] = "Add Budget";
}

<div class="col-md-12 p-4">

    <h2 class="mb-3">Add Budget</h2>

    <a asp-action="Index" class="btn btn-link mb-3">
        ← Back to Budgets
    </a>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Date -->
                <div class="row mb-3">
                    <label asp-for="Date" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <input asp-for="Date"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                </div>

                <!-- Category -->
                <div class="row mb-3">
                    <label asp-for="CategoryId" class="col-md-3 col-form-label">
                        Category
                    </label>

                    <div class="col-md-9">
                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">
                            <option value="">Select Category</option>
                        </select>

                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Budget Amount -->
                <div class="row mb-3">
                    <label asp-for="BudgetAmount" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <input asp-for="BudgetAmount"
                               type="number"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="BudgetAmount" class="text-danger"></span>
                    </div>
                </div>

                <!-- Spent So Far -->
                <div class="row mb-3">
                    <label asp-for="SpentSoFar" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <input asp-for="SpentSoFar"
                               type="number"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="SpentSoFar" class="text-danger"></span>
                    </div>
                </div>

                <!-- Notes -->
                <div class="row mb-4">
                    <label asp-for="Notes" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <textarea asp-for="Notes"
                                  rows="4"
                                  class="form-control"></textarea>

                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Save Budget
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>