@model BizTrack.Models.Budget

@{
    ViewData["Title"] = "Delete Budget";
}

<div class="col-md-12 p-4">

    <h2 class="mb-4">Delete Budget</h2>

    <div class="alert alert-danger shadow-sm">

        <h4 class="alert-heading">
            Are you sure you want to delete this budget?
        </h4>

        <hr />

        <dl class="row">

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">
                @Model.Date.ToString("MMM dd, yyyy")
            </dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">
                @Model.CategoryId
            </dd>

            <dt class="col-sm-3">Budget Amount</dt>
            <dd class="col-sm-9">
                @Model.BudgetAmount.ToString("C")
            </dd>

            <dt class="col-sm-3">Spent So Far</dt>
            <dd class="col-sm-9">
                @Model.SpentSoFar.ToString("C")
            </dd>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">
                    @Model.Notes
                </dd>
            }

        </dl>

        <div class="mt-4">

            <form asp-action="Delete" method="post" class="d-inline">

                @Html.AntiForgeryToken()

                <input asp-for="BudgetId" type="hidden" />

                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

            </form>

            <a asp-action="Index" class="btn btn-secondary ms-2">
                Cancel
            </a>

        </div>

    </div>

</div>
