@model IEnumerable<BizTrack.Models.Income>

@{
    ViewData["Title"] = "Income";

    decimal totalIncome = Model?.Sum(i => i.Amount) ?? 0;
    int incomeCount = Model?.Count() ?? 0;
}

<div class="bg-light">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center py-3 px-4 bg-white border-bottom">
        <h4 class="mb-0">Income</h4>

        <a asp-action="Create" class="btn btn-primary">
            + Add Income
        </a>
    </div>

    <div class="p-4">

        <!-- Total Income Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row align-items-center">

                    <div class="col">
                        <h6 class="text-muted mb-2">Total Income</h6>

                        <h2 class="fw-bold text-success mb-1">
                            @totalIncome.ToString("C")
                        </h2>

                        <small class="text-muted">This month</small>
                    </div>

                    <div class="col-auto">
                        <div class="bg-success bg-opacity-10 rounded p-3">
                            <i class="bi bi-graph-up-arrow text-success fs-1"></i>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <input type="text"
                       class="form-control"
                       placeholder="Search income..." />
            </div>

            <div class="col-md-2">
                <select class="form-select">
                    <option>All Categories</option>
                </select>
            </div>

            <div class="col-md-2">
                <select class="form-select">
                    <option>All Types</option>
                </select>
            </div>

            <div class="col-md-3">
                <input type="text"
                       class="form-control"
                       value="May 1 - May 31, 2024" />
            </div>

        </div>

        <!-- Income Table -->
        <div class="card shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model?.Any() == true)
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Date.ToString("MMM dd, yyyy")</td>

                                        <td>@item.Description</td>

                                        <td>@item.CategoryId</td>

                                        <td class="text-success fw-bold">
                                            @item.Amount.ToString("C")
                                        </td>

                                        <td>@item.PaymentMethod</td>

                                        <td>
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IncomeId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.IncomeId"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        No income found.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                </div>

            </div>
        </div>

        <!-- Footer -->
        <div class="mt-3">
            <small class="text-muted">
                Showing @incomeCount transaction@(incomeCount == 1 ? "" : "s")
            </small>
        </div>

    </div>

</div>