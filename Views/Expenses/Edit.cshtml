@model BizTrack.Models.Expenses

@{
    ViewData["Title"] = "Edit Expense";
}

<div class="col-md-12 p-4">

    <h2 class="mb-3">Edit Expense</h2>

    <a asp-action="Index" class="btn btn-link mb-3">
        ← Back to Expenses
    </a>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="ExpenseId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Date -->
                <div class="row mb-3">
                    <label asp-for="Date" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                </div>

                <!-- Description -->
                <div class="row mb-3">
                    <label asp-for="Description" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <!-- Category -->
                <div class="row mb-3">
                    <label asp-for="CategoryId" class="col-md-3 col-form-label">
                        Category
                    </label>

                    <div class="col-md-9">
                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">
                            <option value="">Select Category</option>
                        </select>

                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Amount -->
                <div class="row mb-3">
                    <label asp-for="Amount" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="row mb-3">
                    <label asp-for="PaymentMethod" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">Select Payment Method</option>
                            <option value="Cash">Cash</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>

                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>
                </div>

                <!-- Notes -->
                <div class="row mb-4">
                    <label asp-for="Notes" class="col-md-3 col-form-label"></label>

                    <div class="col-md-9">
                        <textarea asp-for="Notes"
                                  rows="4"
                                  class="form-control"></textarea>

                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-warning">
                        Update Expense
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>
