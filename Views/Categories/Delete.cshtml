@model BizTrack.Models.Categories

@{
    ViewData["Title"] = "Delete Category";
}

<div class="col-md-12 p-4">

    <h2 class="mb-4">Delete Category</h2>

    <div class="alert alert-danger shadow-sm">

        <h4 class="alert-heading">
            Are you sure you want to delete this category?
        </h4>

        <hr />

        <dl class="row">
            <dt class="col-sm-3">Category ID</dt>
            <dd class="col-sm-9">@Model.CategoryId</dd>

            <dt class="col-sm-3">Category Name</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Icon</dt>
            <dd class="col-sm-9">@Model.Icon</dd>

            <dt class="col-sm-3">Colour</dt>
            <dd class="col-sm-9">@Model.Colour</dd>
        </dl>

        <div class="mt-4">

            <form asp-action="Delete" method="post" class="d-inline">

                @Html.AntiForgeryToken()

                <input asp-for="CategoryId" type="hidden" />

                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

            </form>

            <a asp-action="Index" class="btn btn-secondary ms-2">
                Cancel
            </a>

        </div>

    </div>

</div>

