<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - BizTrack</title>

    <link rel="stylesheet" href="~/css/sb-admin-2.css" />

</head>
<body>

    <div class="container-fluid">
        <div class="row">

            <!-- Left Sidebar -->
            <div class="col-md-2 bg-primary text-white vh-100 p-0">
                <div class="p-3 border-bottom">
                    <h4>BizTrack</h4>
                </div>

                <ul class="nav flex-column p-3">
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Budget"
                           asp-action="Index">
                            Budget
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Categories"
                           asp-action="Index">
                            Categories
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Income"
                           asp-action="Index">
                            Income
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Expenses"
                           asp-action="Index">
                            Expenses
                        </a>
                    </li>

                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Transactions"
                           asp-action="Index">
                            Transactions
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
